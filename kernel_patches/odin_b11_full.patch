+	if (!is_rt_policy(desired->sched_policy) ||
+	    desired->prio < binder_rt_boost_prio) {
+		struct binder_priority boost = {
+			.sched_policy = BINDER_RT_BOOST_POLICY,
+			.prio = binder_rt_boost_prio,
+		};
+		binder_restore_priority(thread, &boost);
+	} else {
+		binder_restore_priority(thread, desired);
+	}
