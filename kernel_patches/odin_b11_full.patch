+static bool binder_rt_boost __read_mostly = true;
+module_param_named(rt_boost, binder_rt_boost, bool, 0644);
+MODULE_PARM_DESC(rt_boost,
+	"Force RT wakeup priority for surfaceflinger binder threads");
+
+/*
+ * RT priority in kernel scale (98 = weakest RT = user FIFO 1).
+ * Default 50 = user FIFO 50: strong enough that cpupri wakeup placement
+ * finds many eligible big cores (spreads wakeups), still far below
+ * SF main thread (user 97 = kernel prio 2).
+ */
+static int binder_rt_boost_prio __read_mostly = 50;
+module_param_named(rt_boost_prio, binder_rt_boost_prio, int, 0644);
+MODULE_PARM_DESC(rt_boost_prio,
+	"Kernel-scale RT priority for the boost (98=weakest..0=strongest)");
