+
+/*in case of a different elaboration of the input, just modify this initial part of the code according to customer needs*/
+	if ((count + 1) / 3 != 1) {
+		logError(1,
+			 "%s %s: Number of bytes of parameter wrong! %d != %d byte\n",
+			 tag, __func__, (count + 1) / 3, 1);
+	} else {
+		sscanf(p, "%02X ", &temp);
+		p += 3;
