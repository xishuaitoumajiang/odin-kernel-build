diff --git a/drivers/kernelsu/policy/feature.c b/drivers/kernelsu/policy/feature.c
new file mode 100644
index 000000000..05ae1636f
--- /dev/null
+++ b/drivers/kernelsu/policy/feature.c
@@ -0,0 +1,295 @@
+static const struct ksu_feature_handler *feature_handlers[KSU_FEATURE_MAX];
+
+static DEFINE_MUTEX(feature_mutex);
+
+static const char *const feature_names[KSU_FEATURE_MAX] = {
+    [KSU_FEATURE_SU_COMPAT] = "su_compat",
+    [KSU_FEATURE_KERNEL_UMOUNT] = "kernel_umount",
+    [KSU_FEATURE_SULOG] = "sulog",
+    [KSU_FEATURE_ADB_ROOT] = "adb_root",
+    [KSU_FEATURE_SELINUX_HIDE] = "selinux_hide",
+    [KSU_FEATURE_SHELL_SU_ADB_ONLY] = "shell_su_adb_only",
+    [KSU_FEATURE_MOUNT_HIDE] = "mount_hide",
+};
+
+// Features forced by boot config. Written only while parsing module params
+// (before kernelsu_init), read-only afterwards.
+static u64 forced_values[KSU_FEATURE_MAX];
+static DECLARE_BITMAP(forced_mask, KSU_FEATURE_MAX);
+// Forced features whose value has not been applied successfully yet
+static DECLARE_BITMAP(forced_pending, KSU_FEATURE_MAX);
+
+static int parse_feature_id(const char *name, u32 *id)
+{
+    u32 i;
+
+    if (!kstrtou32(name, 10, id)) {
+        return *id < KSU_FEATURE_MAX ? 0 : -EINVAL;
+    }
+
+    for (i = 0; i < KSU_FEATURE_MAX; i++) {
+        if (feature_names[i] && !strcmp(name, feature_names[i])) {
+            *id = i;
+            return 0;
+        }
+    }
+
+    return -EINVAL;
+}
+
+// force_feature=<name|id>:<value>[,<name|id>:<value>...]
+// May be specified multiple times. Invalid entries are skipped instead of
+// failing, as a param error would prevent KernelSU from loading at all.
+// This may run before the slab allocator is up (built-in), so don't allocate.
+static int force_feature_param_set(const char *val, const struct kernel_param *kp)
+{
+    char name[32], num[24];
+    const char *p = val, *end, *sep;
+    size_t name_len, num_len;
+    u32 id;
+    u64 value;
+
+    if (!val) {
+        return 0;
+    }
+
+    for (; *p; p = *end ? end + 1 : end) {
+        end = strchrnul(p, ',');
+        if (end == p) {
+            continue;
+        }
+
+        sep = memchr(p, ':', end - p);
+        name_len = sep ? sep - p : 0;
+        num_len = sep ? end - sep - 1 : 0;
+        if (!name_len || name_len >= sizeof(name) || !num_len || num_len >= sizeof(num)) {
+            pr_err("feature: invalid force_feature entry '%.*s'\n", (int)(end - p), p);
+            continue;
+        }
+
+        memcpy(name, p, name_len);
+        name[name_len] = '\0';
+        memcpy(num, sep + 1, num_len);
+        num[num_len] = '\0';
+
+        if (parse_feature_id(name, &id) || kstrtou64(num, 0, &value)) {
+            pr_err("feature: invalid force_feature entry '%s:%s'\n", name, num);
+            continue;
+        }
+
+        forced_values[id] = value;
+        set_bit(id, forced_mask);
+        set_bit(id, forced_pending);
+        pr_info("feature: %s (id=%u) forced to %llu\n", feature_names[id], id, value);
+    }
+
+    return 0;
+}
+
+static const struct kernel_param_ops force_feature_param_ops = {
+    // A bare `force_feature` would otherwise fail parse_args() and the whole module load
+    .flags = KERNEL_PARAM_OPS_FL_NOARG,
+    .set = force_feature_param_set,
+};
+module_param_cb(force_feature, &force_feature_param_ops, NULL, 0);
+
+int __init ksu_register_feature_handler(const struct ksu_feature_handler *handler)
+{
+    if (!handler) {
+        pr_err("feature: register handler is NULL\n");
+        return -EINVAL;
+    }
+
+    if (handler->feature_id >= KSU_FEATURE_MAX) {
+        pr_err("feature: invalid feature_id %u\n", handler->feature_id);
+        return -EINVAL;
+    }
+
+    if (!handler->get_handler && !handler->set_handler) {
+        pr_err("feature: no handler provided for feature %u\n", handler->feature_id);
+        return -EINVAL;
+    }
+
+    mutex_lock(&feature_mutex);
+
+    if (feature_handlers[handler->feature_id]) {
+        pr_warn("feature: handler for %u already registered, overwriting\n", handler->feature_id);
+    }
+
+    feature_handlers[handler->feature_id] = handler;
+
+    pr_info("feature: registered handler for %s (id=%u)\n", handler->name ? handler->name : "unknown",
+            handler->feature_id);
+
+    mutex_unlock(&feature_mutex);
+    return 0;
+}
+
+int ksu_unregister_feature_handler(u32 feature_id)
+{
+    int ret = 0;
+
+    if (feature_id >= KSU_FEATURE_MAX) {
+        pr_err("feature: invalid feature_id %u\n", feature_id);
+        return -EINVAL;
+    }
+
+    mutex_lock(&feature_mutex);
+
+    if (!feature_handlers[feature_id]) {
+        pr_warn("feature: no handler registered for %u\n", feature_id);
+        ret = -ENOENT;
+        goto out;
+    }
+
+    feature_handlers[feature_id] = NULL;
+
+    pr_info("feature: unregistered handler for id=%u\n", feature_id);
+
+out:
+    mutex_unlock(&feature_mutex);
+    return ret;
+}
+
+int ksu_get_feature(u32 feature_id, u64 *value, bool *supported)
+{
+    int ret = 0;
+    const struct ksu_feature_handler *handler;
+
+    if (feature_id >= KSU_FEATURE_MAX) {
+        pr_err("feature: invalid feature_id %u\n", feature_id);
+        return -EINVAL;
+    }
+
+    if (!value || !supported) {
+        pr_err("feature: invalid parameters\n");
+        return -EINVAL;
+    }
+
+    mutex_lock(&feature_mutex);
+
+    handler = feature_handlers[feature_id];
+
+    if (!handler) {
+        *supported = false;
+        *value = 0;
+        pr_debug("feature: feature %u not supported\n", feature_id);
+        goto out;
+    }
+
+    *supported = true;
+
+    if (!handler->get_handler) {
+        pr_warn("feature: no get_handler for feature %u\n", feature_id);
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+
+    ret = handler->get_handler(value);
+    if (ret) {
+        pr_err("feature: get_handler for %u failed: %d\n", feature_id, ret);
+    }
+
+out:
+    mutex_unlock(&feature_mutex);
+    return ret;
+}
+
+int ksu_set_feature(u32 feature_id, u64 value)
+{
+    int ret = 0;
+    const struct ksu_feature_handler *handler;
+
+    if (feature_id >= KSU_FEATURE_MAX) {
+        pr_err("feature: invalid feature_id %u\n", feature_id);
+        return -EINVAL;
+    }
+
+    if (test_bit(feature_id, forced_mask)) {
+        pr_warn("feature: feature %u is forced by boot config\n", feature_id);
+        return -EPERM;
+    }
+
+    mutex_lock(&feature_mutex);
+
+    handler = feature_handlers[feature_id];
+
+    if (!handler) {
+        pr_err("feature: feature %u not registered\n", feature_id);
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+
+    if (!handler->set_handler) {
+        pr_warn("feature: no set_handler for feature %u\n", feature_id);
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+
+    ret = handler->set_handler(value);
+    if (ret) {
+        pr_err("feature: set_handler for %u failed: %d\n", feature_id, ret);
+    }
+
+out:
+    mutex_unlock(&feature_mutex);
+    return ret;
+}
+
+bool ksu_feature_is_forced(u32 feature_id)
+{
+    return feature_id < KSU_FEATURE_MAX && test_bit(feature_id, forced_mask);
+}
+
+void ksu_feature_apply_forced(void)
+{
+    const struct ksu_feature_handler *handler;
+    unsigned int id;
+    int ret;
+
+    mutex_lock(&feature_mutex);
+
+    for_each_set_bit (id, forced_pending, KSU_FEATURE_MAX) {
+        handler = feature_handlers[id];
+        if (!handler || !handler->set_handler) {
+            continue;
+        }
+
+        ret = handler->set_handler(forced_values[id]);
+        if (ret) {
+            pr_warn("feature: apply forced %s=%llu failed: %d\n", feature_names[id], forced_values[id], ret);
+            continue;
+        }
+
+        clear_bit(id, forced_pending);
+        pr_info("feature: applied forced %s=%llu\n", feature_names[id], forced_values[id]);
+    }
+
+    mutex_unlock(&feature_mutex);
+}
+
+void __init ksu_feature_init(void)
+{
+    int i;
+
+    for (i = 0; i < KSU_FEATURE_MAX; i++) {
+        feature_handlers[i] = NULL;
+    }
+
+    pr_info("feature: feature management initialized\n");
+}
+
+void __exit ksu_feature_exit(void)
+{
+    int i;
+
+    mutex_lock(&feature_mutex);
+
+    for (i = 0; i < KSU_FEATURE_MAX; i++) {
+        feature_handlers[i] = NULL;
+    }
+
+    mutex_unlock(&feature_mutex);
+
+    pr_info("feature: feature management cleaned up\n");
+}
diff --git a/drivers/kernelsu/policy/feature.h b/drivers/kernelsu/policy/feature.h
new file mode 100644
index 000000000..14ed40d28
--- /dev/null
+++ b/drivers/kernelsu/policy/feature.h
@@ -0,0 +1,35 @@
+#ifndef __KSU_H_FEATURE
+#define __KSU_H_FEATURE
+
+typedef int (*ksu_feature_get_t)(u64 *value);
+typedef int (*ksu_feature_set_t)(u64 value);
+
+struct ksu_feature_handler {
+    u32 feature_id;
+    const char *name;
+    ksu_feature_get_t get_handler;
+    ksu_feature_set_t set_handler;
+};
+
+int ksu_register_feature_handler(const struct ksu_feature_handler *handler);
+
+int ksu_unregister_feature_handler(u32 feature_id);
+
+int ksu_get_feature(u32 feature_id, u64 *value, bool *supported);
+
+int ksu_set_feature(u32 feature_id, u64 value);
+
+// Whether the feature is forced by the force_feature module param, in which
+// case ksu_set_feature() refuses to change it.
+bool ksu_feature_is_forced(u32 feature_id);
+
+// Apply forced feature values not applied yet. Called at several boot stages
+// since some handlers can only succeed late (e.g. selinux_hide needs the
+// sepolicy backup).
+void ksu_feature_apply_forced(void);
+
+void ksu_feature_init(void);
+
+void ksu_feature_exit(void);
+
+#endif // __KSU_H_FEATURE
diff --git a/drivers/kernelsu/preinit/blob.S b/drivers/kernelsu/preinit/blob.S
new file mode 100644
index 000000000..84ca6c733
--- /dev/null
+++ b/drivers/kernelsu/preinit/blob.S
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Embed the preinit runner. It is only needed until ksu_preinit_init() copies
+ * it into shmem, so keep it in an init section that is freed after load.
+ */
+	.section .init.rodata, "a"
+	.balign 16
+	.global ksu_preinit_runner_start
+ksu_preinit_runner_start:
+	.incbin KSU_PREINIT_RUNNER_BIN
+	.global ksu_preinit_runner_end
+ksu_preinit_runner_end:
diff --git a/drivers/kernelsu/preinit/common/preinit.c b/drivers/kernelsu/preinit/common/preinit.c
new file mode 100644
index 000000000..a0670c7cb
--- /dev/null
+++ b/drivers/kernelsu/preinit/common/preinit.c
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 \xx
+ *
+ * This file is a downstream extension and NOT affiliated, endorsed by,
+ * or maintained by the official KernelSU developers.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ */
+// adapted from: https://github.com/tiann/KernelSU/pull/3907
+#define INIT_PATH "/system/bin/init"
+
+static bool ksu_preinit_enabled = true;
+module_param_named(preinit, ksu_preinit_enabled, bool, 0);
+
+static bool is_selinux_setup(const char __user *const __user *argv_user)
+{
+	static const char expected[] = "selinux_setup";
+	const char __user *arg;
+	char buf[sizeof(expected) + 1];
+
+	if (!argv_user)
+		return false;
+
+	if (is_compat_task()) {
+		uint32_t __user *compat_argv_user = (uint32_t __user *)argv_user;
+		uint32_t arg32_p;
+		if (get_user(arg32_p, compat_argv_user + 1))
+			return false;
+		arg = (void *)(uintptr_t)arg32_p;
+	} else {
+		if (get_user(arg, argv_user + 1))
+			return false;
+	}
+
+	if (!arg)
+		return false;
+
+	memset(buf, 0, sizeof(buf));
+	if (strncpy_from_user(buf, arg, sizeof(buf) - 1) < 0)
+		return false;
+
+	return !strcmp(buf, expected);
+}
+
+static void ksu_stage_preinit_binary(void ***u_argv, void ***u_envp)
+{
+	struct file *file;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+	file = shmem_file_setup("ksu_preinit_mem", runner_binary_len, EMPTY_VMA_FLAGS);
+#else
+	file = shmem_file_setup("ksu_preinit_mem", runner_binary_len, 0);
+#endif
+	if (IS_ERR(file)) {
+		pr_err("preinit: shmem_file_setup failed: %ld\n", PTR_ERR(file));
+		return;
+	}
+
+	loff_t pos = 0;
+	int ret = kernel_write(file, runner_binary, runner_binary_len, &pos);
+	if (ret != (ssize_t)runner_binary_len) {
+		pr_err("preinit: kernel_write to shmem failed: %d\n", ret);
+		fput(file);
+		return;
+	}
+
+	pr_info("preinit: runner staged (%zu bytes)\n", runner_binary_len);
+
+	int fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0) {
+		pr_err("preinit: get fd failed: %d\n", fd);
+		fput(file);
+		return;
+	}
+
+	// The fd owns the file from here on; close-on-exec frees it once the
+	// runner has been loaded.
+	fd_install(fd, file);
+
+	char fd_path[32];
+	int len = snprintf(fd_path, sizeof(fd_path), "/proc/self/fd/%d", fd);
+
+	struct path p;
+	if (kern_path(fd_path, LOOKUP_FOLLOW, &p)) {
+		pr_err("preinit: %s not reachable, booting without preinit\n", fd_path);
+		ksu_close_fd(fd);
+		return;
+	}
+	path_put(&p);
+
+	uintptr_t mmap_page = vm_mmap(NULL, 0, PAGE_SIZE, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (IS_ERR_VALUE(mmap_page)) {
+		pr_info("preinit: mmap fail!\n");
+		ksu_close_fd(fd);
+		return;
+	}
+
+	pr_info("preinit: mmap_page: 0x%lx \n", mmap_page);
+
+	const char __user **argv_user = (const char __user **)*(void ***)u_argv;
+	const char __user **envp_user = (const char __user **)*(void ***)u_envp;
+
+// payload definition
+	struct execve_payload {
+		char c_argv0[32];	// "/system/bin/init", mmap_page will point here
+		char c_argv1[32];	// "selinux_setup"
+		char filename[32];	// fd_path
+		uintptr_t argv[3];	// **argv: argv0, argv1, NULL terminator
+		uintptr_t envp[17];	// envp mirror, pointer extended.
+	}; // 4 cachelines
+	static_assert(32 > sizeof(INIT_PATH));
+// payload definition
+
+	struct execve_payload payload = { 0 };
+	memcpy(payload.c_argv0, INIT_PATH, sizeof(INIT_PATH));
+	memcpy(payload.c_argv1, "selinux_setup", sizeof("selinux_setup"));
+	memcpy(payload.filename, fd_path, len + 1);
+	payload.argv[0] = mmap_page;			// ptr to c_argv0
+	payload.argv[1] = mmap_page + 32;		// ptr to c_argv1
+	payload.argv[2] = 0x0;				// nullptr
+
+	void __user *u_filename = (void __user *)(mmap_page + offsetof(struct execve_payload, filename));
+	void __user *u_argv_ptr = (void __user *)(mmap_page + offsetof(struct execve_payload, argv));
+	void __user *u_envp_ptr = nullptr;
+
+	if (!is_compat_task())
+		goto native;
+
+	pr_info("preinit: compat init found! argv: 0x%lx envp: 0x%lx \n", (uintptr_t)argv_user, (uintptr_t)envp_user);
+
+	// if compat task we need to mirror original envp with widened ptr
+	uint32_t __user *u_env32 = (uint32_t __user *)envp_user;
+	int c = 0;
+	while (c < 16) {
+		uint32_t compat = 0;
+		if (get_user(compat, &u_env32[c]))
+			break;
+
+		if (!compat)
+			break;
+
+		payload.envp[c] = (uintptr_t)compat; // extend
+		pr_info("preinit: debug: envp: 0x%lx \n", payload.envp[c]);
+		c++;
+	}
+	payload.envp[c] = 0x0;
+	u_envp_ptr = (void __user *)(mmap_page + offsetof(struct execve_payload, envp));
+	goto send_payload;
+
+native:; // not really needed, we can pass original envp, but its a straight up copy paste anyway
+	uintptr_t __user *u_env_native = (uintptr_t __user *)envp_user;
+	int n = 0;
+	while (n < 16) {
+		uintptr_t native = 0;
+		if (get_user(native, &u_env_native[n]))
+			break;
+
+		if (!native)
+			break;
+
+		payload.envp[n] = (uintptr_t)native;
+		pr_info("preinit: debug: envp: 0x%lx \n", payload.envp[n]);
+		n++;
+	}
+	payload.envp[n] = 0x0;
+	u_envp_ptr = (void __user *)(mmap_page + offsetof(struct execve_payload, envp));
+
+send_payload:
+	if (!!copy_to_user((void __user *)mmap_page, &payload, sizeof(struct execve_payload))) {
+		pr_info("preinit: debug: copy_to_user mmap failed \n");
+		goto unmap_and_close;
+	}
+
+	pr_info("preinit: exec runner via %s\n", fd_path);
+	pr_info("preinit: syscall(SYS_execve, 0x%lx, 0x%lx, 0x%lx);\n", (uintptr_t)u_filename, (uintptr_t)u_argv_ptr, (uintptr_t)u_envp_ptr);
+
+	long eret = ksyscall(execve, u_filename, u_argv_ptr, u_envp_ptr);
+	pr_info("preinit: sys_execve runner returned: %ld \n", eret);
+	if (!eret)
+		return;
+
+unmap_and_close: // not rly needed, but its ok.
+	vm_munmap(mmap_page, PAGE_SIZE);
+	ksu_close_fd(fd);
+	return;
+}
+
+static noinline void ksu_preinit_handle_kexecve(void **filename, void *kargv, void *kenvp)
+{
+	if (!current->mm || current->pid != 1)
+		return;
+
+	assume_dereferenceable(*filename, 32);
+
+	constexpr char expected[] = INIT_PATH;
+	if (!!memcmp_inline(*(char **)filename, expected, sizeof(expected)))
+		return;
+
+	pr_info("preinit: kernel_execve: %s \n", INIT_PATH);
+
+	struct user_arg_ptr *argv = (struct user_arg_ptr *)kargv;
+	void ***u_argv = (void ***)&argv->ptr.native;
+#ifdef CONFIG_COMPAT
+	if (argv->is_compat)
+		u_argv = (void ***)&argv->ptr.compat;
+#endif
+
+	if (!is_selinux_setup((const char __user **)*(void ***)u_argv))
+		return;
+
+	struct user_arg_ptr *envp = (struct user_arg_ptr *)kenvp;
+	void ***u_envp = (void ***)&envp->ptr.native;
+#ifdef CONFIG_COMPAT
+	if (envp->is_compat)
+		u_envp = (void ***)&envp->ptr.compat;
+#endif
+
+	pr_info("preinit: kernel_execve: /system/bin/init with selinux_setup! \n");
+
+	kthread_run(ksu_disable_preinit_branch, nullptr, "kthread");
+
+	ksu_stage_preinit_binary(u_argv, u_envp);
+}
+
+// filename is void *char __user *
+static noinline void ksu_preinit_handle_uexecve(const char __user **filename, void *u_argv, void *u_envp)
+{
+	if (!current->mm || current->pid != 1)
+		return;
+
+	constexpr char expected[] = INIT_PATH;
+
+	char buf[sizeof(expected) + 1];
+	buf[sizeof(buf) - 1] = 0;
+	if (!!copy_from_user_retry(buf, *filename, sizeof(buf) - 1 ))
+		return;
+
+	if (!!strcmp(buf, expected))
+		return;
+
+	pr_info("preinit: sys_execve: %s \n", INIT_PATH);
+
+	if (!is_selinux_setup((const char __user **)*(void ***)u_argv))
+		return;
+
+	pr_info("preinit: sys_execve: %s with selinux_setup! \n", INIT_PATH);
+
+	kthread_run(ksu_disable_preinit_branch, nullptr, "kthread");
+
+	ksu_stage_preinit_binary((void ***)u_argv, (void ***)u_envp);
+}
+
+static inline void ksu_preinit_kernel_execve_hook(void **filename, void *k_argv, void *k_envp)
+{
+	if (static_branch_unlikely(&ksu_preinit_key))
+		ksu_preinit_handle_kexecve(filename, k_argv, k_envp);
+}
+
+static inline void ksu_preinit_user_execve_hook(const char __user **filename, void *u_argv, void *u_envp)
+{
+	if (static_branch_unlikely(&ksu_preinit_key))
+		ksu_preinit_handle_uexecve(filename, u_argv, u_envp);
+}
+
+void ksu_preinit_release(void) { }
+
+void ksu_preinit_init(void)
+{
+	if (!ksu_preinit_enabled) {
+		pr_info("preinit: disabled!\n");
+		return;
+	}
+	
+	static_branch_enable(&ksu_preinit_key);
+	kick_all_cpus_sync();
+	pr_info("preinit: enabled!\n");
+	return;
+}
+
+void ksu_preinit_exit(void) { }
diff --git a/drivers/kernelsu/preinit/common/preinit.h b/drivers/kernelsu/preinit/common/preinit.h
new file mode 100644
index 000000000..980cf0a84
--- /dev/null
+++ b/drivers/kernelsu/preinit/common/preinit.h
@@ -0,0 +1,44 @@
+#ifndef __KSU_H_PREINIT
+#define __KSU_H_PREINIT
+
+#if !defined(CONFIG_ARM64) || !defined(KSU_CAN_USE_JUMP_LABEL)
+#define KSU_NO_PREINIT
+#endif
+
+#ifndef KSU_NO_PREINIT
+
+void ksu_preinit_init(void);
+void ksu_preinit_exit(void);
+
+// NOTE: even if this has to be enabled by default, this has better codegen on execve.
+DEFINE_STATIC_KEY_FALSE(ksu_preinit_key);
+
+static inline void ksu_preinit_kernel_execve_hook(void **filename, void *k_argv, void *k_envp);
+static inline void ksu_preinit_user_execve_hook(const char __user **filename, void *u_argv, void *u_envp);
+
+static int ksu_disable_preinit_branch(void *data)
+{
+	static bool disabled = false;
+	if (disabled)
+		return 0;
+
+	pr_info("preinit: remove preinit execve branches\n");
+	static_branch_disable(&ksu_preinit_key);
+	kick_all_cpus_sync();
+
+	disabled = true;
+	return 0;
+}
+#else
+
+#define ksu_preinit_init() do { } while (0)
+#define ksu_preinit_exit() do { } while (0)
+
+#define ksu_preinit_kernel_execve_hook(...)	do { } while (0)
+#define ksu_preinit_user_execve_hook(...)	do { } while (0)
+
+#define ksu_disable_preinit_branch(...)		do { } while (0)
+
+#endif // KSU_NO_PREINIT
+
+#endif // __KSU_H_PREINIT
diff --git a/drivers/kernelsu/preinit/common/runner/Makefile b/drivers/kernelsu/preinit/common/runner/Makefile
new file mode 100644
index 000000000..915d7b665
--- /dev/null
+++ b/drivers/kernelsu/preinit/common/runner/Makefile
@@ -0,0 +1,36 @@
+CC = zig cc
+SRC = runner.c
+TARGET = runner_binary
+DUMP = runner_xxd.h
+
+ZIG_VER := $(shell zig version)
+
+CFLAGS += -target aarch64-linux -std=gnu23
+CFLAGS += -Oz -flto -s -static
+CFLAGS += -fno-unwind-tables -fmerge-all-constants
+CFLAGS +=  -fno-builtin-memcpy
+CFLAGS += -Wl,--entry=__start
+CFLAGS += -s -Wl,--gc-sections,-z,norelro
+CFLAGS += -Wno-int-conversion -Wno-unknown-attributes -Wno-macro-redefined
+
+CFLAGS += -DZIG_VERSION=\"$(ZIG_VER)\"
+
+all: $(TARGET) $(DUMP)
+
+$(TARGET): $(SRC)
+	$(CC) $(CFLAGS) $(SRC) -o $@
+	@if command -v sstrip >/dev/null 2>&1; then sstrip $(TARGET); fi
+#	@if command -v upx >/dev/null 2>&1; then upx --ultra-brute $(TARGET); fi
+
+$(DUMP): $(TARGET)
+# maybe in 10 years C23 #embed will be the norm
+# for now not a big deal for a < 15kb binary.
+	xxd -i $(TARGET) > $@
+	tail -n1 $@
+	rm -f $(TARGET)
+
+clean:
+	rm -f $(TARGET) > /dev/null 2>&1
+	rm -f $(DUMP) > /dev/null 2>&1
+
+.PHONY: all clean
