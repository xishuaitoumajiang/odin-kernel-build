+static int clear_interrupt(void)
+{
+	u8 cmd[6] = {0xfa, 0x20, 0x00, 0x00, 0x29, 0x02};
+	int ret = 0;
+
+	ret = fts_write_dma_safe(cmd, ARRAY_SIZE(cmd));
+	if (ret < OK) {
+		logError(1, "%s %s: write failed...ERROR %08X !\n", tag,
+			 __func__, ret);
+		return -EPERM;
+	}
+	return 0;
+}
