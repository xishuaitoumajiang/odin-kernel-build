+	/* [odin] cache short-circuit on the innermost filter (KSU allow_cache) */
+	if (this_syscall >= 0 && this_syscall < __NR_syscalls) {
+		struct seccomp_filter *f = READ_ONCE(current->seccomp.filter);
+
+		if (f && test_bit(this_syscall, f->allow_native))
+			filter_ret = SECCOMP_RET_ALLOW;
+		else
+			filter_ret = seccomp_run_filters(sd, &match);
+	} else
+		filter_ret = seccomp_run_filters(sd, &match);
 	data = filter_ret & SECCOMP_RET_DATA;
 	action = filter_ret & SECCOMP_RET_ACTION_FULL;
 
@@ -1856,3 +1885,131 @@ static int __init seccomp_sysctl_init(void)
 device_initcall(seccomp_sysctl_init)
 
 #endif /* CONFIG_SYSCTL */
+
+
+/* [odin-selftest] /proc/odin_sectest - report how a process seccomp chain
+ * would judge selected syscalls (filters evaluated, syscall never issued).
+ * Write a pid to test that process instead of the reader (proxy mode):
+ *   echo 2809 > /proc/odin_sectest ; cat /proc/odin_sectest
+ * Proves the real-filter 5.4 port on-device:
+ *   root/ksu(no filter): mode=0 no-filter
+ *   normal app (filter) : reboot=ERRNO syslog=ERRNO
+ *   KSU-allowed app     : reboot=ALLOW (allow_native short-circuit)
+ */
+#ifdef CONFIG_PROC_FS
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/sched/task.h>
+
+static int odin_st_target;
+
+static void odin_st_report(struct seq_file *m, struct task_struct *tsk)
+{
+	struct seccomp_data sd;
+	struct seccomp_filter *f;
+	u32 ret, action;
+	int i;
+	static const int nr_tab[] = { __NR_getpid, __NR_reboot, __NR_syslog,
+				      __NR_swapon };
+	static const char *nm_tab[] = { "getpid", "reboot", "syslog",
+					"swapon" };
+
+	seq_printf(m, "pid=%d uid=%d mode=%d\n", task_tgid_nr(tsk),
+		   __kuid_val(task_uid(tsk)), tsk->seccomp.mode);
+	if (tsk->seccomp.mode != SECCOMP_MODE_FILTER ||
+	    !tsk->seccomp.filter) {
+		seq_puts(m, "state: no-filter\n");
+		return;
+	}
+	seq_puts(m, "state: filter\n");
+	for (i = 0; i < ARRAY_SIZE(nr_tab); i++) {
+		memset(&sd, 0, sizeof(sd));
+		sd.nr = nr_tab[i];
+		sd.arch = AUDIT_ARCH_AARCH64;
+		f = READ_ONCE(tsk->seccomp.filter);
+		if (f && test_bit(nr_tab[i], f->allow_native)) {
+			ret = SECCOMP_RET_ALLOW;
+		} else {
+			/* manual chain walk: seccomp_run_filters() evaluates
+			 * current, so walk the TARGET chain ourselves */
+			ret = SECCOMP_RET_ALLOW;
+			preempt_disable();
+			for (; f; f = f->prev) {
+				u32 cur = BPF_PROG_RUN(f->prog, &sd);
+				if ((int)(cur & SECCOMP_RET_ACTION_FULL) <
+				    (int)(ret & SECCOMP_RET_ACTION_FULL))
+					ret = cur;
+			}
+			preempt_enable();
+		}
+		action = ret & SECCOMP_RET_ACTION_FULL;
+		seq_printf(m, "%-8s action=0x%08x %s\n", nm_tab[i], action,
+			   action == SECCOMP_RET_ALLOW ? "ALLOW" :
+			   action == SECCOMP_RET_ERRNO ? "ERRNO" :
+			   action == SECCOMP_RET_TRACE ? "TRACE" :
+			   action == SECCOMP_RET_LOG ? "LOG" :
+			   action == SECCOMP_RET_TRAP ? "TRAP" :
+			   "KILL");
+	}
+}
+
+static int odin_sectest_show(struct seq_file *m, void *v)
+{
+	struct task_struct *tsk = current;
+
+	if (odin_st_target > 0) {
+		rcu_read_lock();
+		tsk = find_task_by_vpid(odin_st_target);
+		if (tsk)
+			get_task_struct(tsk);
+		rcu_read_unlock();
+		if (tsk) {
+			odin_st_report(m, tsk);
+			put_task_struct(tsk);
+		} else {
+			seq_printf(m, "target %d not found\n", odin_st_target);
+		}
+	} else {
+		odin_st_report(m, current);
+	}
+	return 0;
+}
+
+static ssize_t odin_sectest_write(struct file *file, const char __user *buf,
+				  size_t len, loff_t *off)
+{
+	char tmp[16];
+	int pid;
+
+	if (len >= sizeof(tmp))
+		return -EINVAL;
+	if (copy_from_user(tmp, buf, len))
+		return -EFAULT;
+	tmp[len] = 0;
+	if (kstrtoint(tmp, 10, &pid))
+		return -EINVAL;
+	odin_st_target = pid;
+	return len;
+}
+
+static int odin_sectest_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, odin_sectest_show, NULL);
+}
+
+static const struct file_operations odin_sectest_fops = {
+	.open		= odin_sectest_open,
+	.read		= seq_read,
+	.write		= odin_sectest_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+static int __init odin_sectest_init(void)
+{
+	if (proc_create("odin_sectest", 0644, NULL, &odin_sectest_fops))
+		pr_info("odin: /proc/odin_sectest registered\n");
+	return 0;
+}
+late_initcall(odin_sectest_init);
+#endif /* CONFIG_PROC_FS */
