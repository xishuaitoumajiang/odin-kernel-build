+int ksu_extension_version_spoof_wipe(u32 id);
+void ksu_version_spoof_apply_info(struct ksu_get_info_cmd *cmd);
+void ksu_version_spoof_apply_info_legacy(struct ksu_get_info_legacy_cmd *cmd);
