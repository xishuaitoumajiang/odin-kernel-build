+int fts_palm_sensor_write(int value)
+{
+	int ret = 0;
+#ifdef CONFIG_SECURE_TOUCH
+	struct fts_secure_info *scr_info = fts_info->secure_info;
+#endif
+
+	fts_info->palm_sensor_switch = value;
