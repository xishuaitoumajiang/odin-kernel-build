+00 active mode
+02 idle mode
+04 mutual r0
+05 mutual r1
+06 mutual r2
+07 mutual r3
+*/
+static int fts_lock_scan_mode(int mode)
+{
+	u8 cmd[3] = {0xa0, 0x03, 0x00};
+	int ret = 0;
+	logError(1, "%s %s: mode:%d\n", tag, __func__, mode);
+	cmd[2] = mode;
+	ret = fts_write_dma_safe(cmd, ARRAY_SIZE(cmd));
+	if (ret < OK) {
+		logError(1, "%s %s: write failed...ERROR %08X !\n", tag, __func__, ret);
+		return -EPERM;
+	}
+	return 0;
+}
