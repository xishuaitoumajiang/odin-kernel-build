+	if (fts_info->sensor_sleep) {
+		fts_info->prox_sensor_changed = false;
+		return 0;
+	}
+	ret = fts_prox_sensor_cmd(value);
+
+	if (!ret)
+		fts_info->prox_sensor_changed = true;
+
+	return ret;
+}
