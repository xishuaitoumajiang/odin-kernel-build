+/*
+ * screen_boost helper: set min_freq (Hz) for a devfreq device matched by
+ * substring of its (or its parent's) device name. freq=0 clears the floor.
+ */
+int devfreq_boost_min_by_name(const char *name, unsigned long freq)
+{
+	struct devfreq *df;
+	int ret = -ENODEV;
+
+	mutex_lock(&devfreq_list_lock);
+	list_for_each_entry(df, &devfreq_list, node) {
+		const char *n1 = dev_name(&df->dev);
+		const char *n2 = df->dev.parent ? dev_name(df->dev.parent) : NULL;
+
+		if ((n1 && strstr(n1, name)) || (n2 && strstr(n2, name))) {
+			mutex_lock(&df->lock);
+			if (freq > df->max_freq)
+				freq = df->max_freq;
+			df->min_freq = freq;
+			update_devfreq(df); /* v5: hold lock across update_devfreq */
+			mutex_unlock(&df->lock);
+			ret = 0;
+			break;
+		}
+	}
+	mutex_unlock(&devfreq_list_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(devfreq_boost_min_by_name);
