+#define isdigit(x) ((x) >= '0' && (x) <= '9')
+static noinline long dumb_atol(const char *str)
+{
+	long res = 0;
+	if (!str || !*str)
+		return res;
+start:
+	if (!isdigit((unsigned char)*str))
+		return res;
+
+	res = (res * 10) + (*str - 48);
+	str++;
+	if (*str)
+		goto start;
