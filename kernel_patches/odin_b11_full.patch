+// SPDX-License-Identifier: GPL-2.0
+/*
+ * cpufreq_screen_boost: raise cpufreq min-freq briefly on screen-on.
+ * Hooked from sde_encoder virt_enable/virt_disable (display unblank/blank).
+ * Tunables: /sys/module/cpufreq_screen_boost/parameters/
+ */
+#define pr_fmt(fmt) "screen_boost: " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/export.h>
+#include <linux/pm_qos.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <linux/moduleparam.h>
+#include <linux/printk.h>
+
+static bool sb_en = true;
+module_param_named(enable, sb_en, bool, 0644);
+static uint sb_dur_ms = 8000;
+module_param_named(duration_ms, sb_dur_ms, uint, 0644);
+static uint sb_min_little = 1401600;
+module_param_named(min_little, sb_min_little, uint, 0644);
+static uint sb_min_big = 1881600;
+module_param_named(min_big, sb_min_big, uint, 0644);
+static uint sb_min_prime = 2496000;
+module_param_named(min_prime, sb_min_prime, uint, 0644);
+static uint sb_gpu_min_mhz = 608;
+module_param_named(gpu_min_mhz, sb_gpu_min_mhz, uint, 0644);
+
+/* sb_v4: 走 devfreq 内核 API, 绕开 sysfs SELinux 限制; 0 = 清除下限 */
+extern int devfreq_boost_min_by_name(const char *name, unsigned long freq);
+
+static void sb_gpu_min(unsigned int mhz)
+{
+	int ret = devfreq_boost_min_by_name("kgsl-3d0",
+					    (unsigned long)mhz * 1000000UL);
+
+	if (ret)
+		pr_warn("gpu min_freq %uMHz failed (%d)\n", mhz, ret);
+	else
+		pr_info("gpu min_freq -> %uMHz\n", mhz);
+} /* sb_v4 */
+
+struct sb_req {
+	struct freq_qos_request qos;
+	bool active;
+};
+static struct sb_req *sb_reqs;
+static DEFINE_MUTEX(sb_lock);
+static bool sb_boosted;
+static void sb_restore_work(struct work_struct *ws);
+static DECLARE_DELAYED_WORK(sb_restore_dwork, sb_restore_work);
+
+static unsigned int sb_cluster_min(unsigned int cpu)
+{
+	if (cpu < 4)
+		return sb_min_little;
+	if (cpu < 7)
+		return sb_min_big;
+	return sb_min_prime;
+}
+
+static void sb_apply(void)
+{
+	unsigned int cpu;
+
+	mutex_lock(&sb_lock);
+	if (sb_boosted) {
+		mod_delayed_work(system_wq, &sb_restore_dwork,
+				 msecs_to_jiffies(sb_dur_ms));
+		mutex_unlock(&sb_lock);
+		return;
+	}
+	for_each_possible_cpu(cpu) {
+		struct cpufreq_policy *p;
+		struct sb_req *r = &sb_reqs[cpu];
+		unsigned int target;
+
+		if (r->active)
+			continue;
+		p = cpufreq_cpu_get_raw(cpu);
+		if (!p || p->cpu != cpu)
+			continue;
+		target = sb_cluster_min(cpu);
+		if (target > p->cpuinfo.max_freq)
+			target = p->cpuinfo.max_freq;
+		{
+			int ret2 = freq_qos_add_request(&p->constraints, &r->qos,
+						 FREQ_QOS_MIN, target);
+			if (ret2 < 0) {
+				pr_warn("cpu%u: qos add failed (%d)\n", cpu, ret2);
+				continue;
+			}
+			/* ret2 >= 0: 0=no-change 1=value-changed, 均为成功 */
+		}
+		r->active = true;
+		pr_info("cpu%u: min->%u\n", cpu, target);
+	}
+	sb_boosted = true;
+	schedule_delayed_work(&sb_restore_dwork, msecs_to_jiffies(sb_dur_ms));
+	mutex_unlock(&sb_lock);
+	sb_gpu_min(sb_gpu_min_mhz);
+}
+
+static void sb_do_restore(void)
+{
+	unsigned int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct sb_req *r = &sb_reqs[cpu];
+
+		if (r->active) {
+			freq_qos_remove_request(&r->qos);
+			r->active = false;
+		}
+	}
+	sb_boosted = false;
+	sb_gpu_min(0);
+}
+
+static void sb_restore_work(struct work_struct *ws)
+{
+	mutex_lock(&sb_lock);
+	sb_do_restore();
+	pr_info("boost restored\n");
+	mutex_unlock(&sb_lock);
+}
+
+void sb_screen_on(void)
+{
+	if (sb_en)
+		sb_apply();
+}
+EXPORT_SYMBOL_GPL(sb_screen_on);
+
+void sb_screen_off(void)
+{
+	/*
+	 * v2: 不再立即取消。AOD/keyguard 过渡会触发 encoder disable,
+	 * 若在此处 cancel 会把亮屏 boost 窗口掐短 (实测 1.8s 即失效)。
+	 * 灭屏后 boost 至多残留 duration_ms, 功耗代价可忽略。
+	 */
+}
+EXPORT_SYMBOL_GPL(sb_screen_off);
+
+static int __init sb_init(void)
+{
+	sb_reqs = kcalloc(num_possible_cpus(), sizeof(*sb_reqs), GFP_KERNEL);
+	if (!sb_reqs)
+		return -ENOMEM;
+	pr_info("ready (dur=%ums little=%u big=%u prime=%u)\n",
+		sb_dur_ms, sb_min_little, sb_min_big, sb_min_prime);
+	return 0;
+}
+fs_initcall(sb_init);
