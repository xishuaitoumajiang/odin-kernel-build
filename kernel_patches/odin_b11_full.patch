+
+#define KSU_INVALID_APPID -1
+#define KSU_PER_USER_RANGE 100000
+
+bool ksu_manager_enabled(void);
+bool ksu_manager_uid_authorized(uid_t uid);
+bool ksu_manager_package_authorized(const char *package, uid_t uid);
