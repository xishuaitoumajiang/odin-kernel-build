+static void fts_ts_sleep_work(struct work_struct *work)
+{
+	struct fts_ts_info *info = container_of(work, struct fts_ts_info, sleep_work);
+	int error = 0, count = 0;
+	unsigned char regAdd = FIFO_CMD_READALL;
+	unsigned char data[FIFO_EVENT_SIZE * FIFO_DEPTH] = {0};
+	unsigned char eventId;
+	const unsigned char EVENTS_REMAINING_POS = 7;
+	const unsigned char EVENTS_REMAINING_MASK = 0x1F;
+	unsigned char events_remaining = 0;
+	unsigned char *evt_data;
+	static char pre_id[3];
+	event_dispatch_handler_t event_handler;
+	int r;
+	fts_disableInterrupt();
+	if (info->tp_pm_suspend) {
+		r = wait_for_completion_timeout(&info->pm_resume_completion, msecs_to_jiffies(500));
+		if (!r) {
+			logError(1, "%s pm_resume_completion timeout, i2c is closed", tag);
+			pm_relax(info->dev);
+			fts_enableInterrupt();
+#ifdef CONFIG_FTS_BOOST
+			lpm_disable_for_dev(false, EVENT_INPUT);
+#endif
+			return;
+		} else {
+			logError(1, "%s pm_resume_completion be completed, handling irq", tag);
+		}
+	}
+
+	info->irq_status = true;
+	error = fts_writeReadU8UX(regAdd, 0, 0, data, FIFO_EVENT_SIZE,
+				  DUMMY_FIFO);
+	events_remaining = data[EVENTS_REMAINING_POS] & EVENTS_REMAINING_MASK;
+	events_remaining = (events_remaining > FIFO_DEPTH - 1) ?
+				FIFO_DEPTH - 1 : events_remaining;
+
+	/*Drain the rest of the FIFO, up to 31 events*/
+	if (error == OK && events_remaining > 0) {
+		error = fts_writeReadU8UX(regAdd, 0, 0, &data[FIFO_EVENT_SIZE],
+					  FIFO_EVENT_SIZE * events_remaining,
+					  DUMMY_FIFO);
+	}
+	if (error != OK) {
+		logError(1,
+			"Error (%d) while reading from FIFO in fts_event_handler",
+			error);
+	} else {
+		for (count = 0; count < events_remaining + 1; count++) {
+			evt_data = &data[count * FIFO_EVENT_SIZE];
+			if (pre_id[0] == EVT_ID_USER_REPORT &&
+				pre_id[1] == 0x02 &&
+				pre_id[2] == 0x18) {
+				pre_id[0] = 0;
+				pre_id[1] = 0;
+				pre_id[2] = 0;
+				continue;
+			}
+			if (evt_data[0] == EVT_ID_NOEVENT)
+				break;
+			eventId = evt_data[0] >> 4;
+			/*Ensure event ID is within bounds*/
+			if (eventId < NUM_EVT_ID) {
+				event_handler = info->event_dispatch_table[eventId];
+				event_handler(info, (evt_data));
+				pre_id[0] = evt_data[0];
+				pre_id[1] = evt_data[1];
+				pre_id[2] = evt_data[2];
+			}
+		}
+	}
+	input_sync(info->input_dev);
+	info->irq_status = false;
+#ifdef FTS_XIAOMI_TOUCHFEATURE
+	wake_up(&info->wait_queue);
+#endif
+	pm_relax(info->dev);
+	fts_enableInterrupt();
+#ifdef CONFIG_FTS_BOOST
+	lpm_disable_for_dev(false, EVENT_INPUT);
+#endif
+
+	return;
+}
+
+/**
+ * Delayed re-enable of the touch IRQ after an empty-FIFO backoff.
+ * Runs on system_wq: the driver irq_wq is max_active=1 and shared with
+ * fts_ts_sleep_work, which may block up to 500 ms waiting for
+ * pm_resume_completion - far too long to hold the touch IRQ disabled.
+ */
+static void fts_empty_irq_work(struct work_struct *work)
+{
+	struct delayed_work *dwork = to_delayed_work(work);
+	struct fts_ts_info *info =
+		container_of(dwork, struct fts_ts_info, empty_irq_work);
+
+	mutex_lock(&info->empty_irq_lock);
+	if (atomic_xchg(&info->empty_irq_armed, 0))
+		enable_irq(info->client->irq);
+	mutex_unlock(&info->empty_irq_lock);
+}
+
+/**
+ * Cancel any pending empty-FIFO backoff and make sure the IRQ ends up
+ * enabled. Called from suspend/resume work and from remove, always in
+ * process context. The mutex closes the cmpxchg->disable window in
+ * fts_empty_irq_backoff(): a concurrent cancel can no longer consume
+ * the armed flag before disable_irq_nosync() runs, which would
+ * otherwise leave the IRQ permanently disabled (unbalanced depth).
+ */
+static void fts_empty_irq_cancel(struct fts_ts_info *info)
+{
+	cancel_delayed_work_sync(&info->empty_irq_work);
+	mutex_lock(&info->empty_irq_lock);
+	if (atomic_xchg(&info->empty_irq_armed, 0))
+		enable_irq(info->client->irq);
+	mutex_unlock(&info->empty_irq_lock);
+	info->empty_irq_streak = 0;
+	info->empty_irq_delay_ms = FTS_EMPTY_IRQ_DELAY_MIN_MS;
+}
+
+/**
+ * Back off the touch IRQ after repeated empty FIFO reads.
+ *
+ * The 0x87 FIFO read that acknowledges the controller has already
+ * happened at the top of fts_event_handler(); only the re-enable is
+ * delayed here. The rate limit is 1 -> 2 -> 4 ms (capped at 4 ms) and
+ * is reset by the next non-empty FIFO. The disable/enable pair is
+ * accounted strictly 1:1 through empty_irq_armed + empty_irq_lock,
+ * so it stays balanced against the lib's own disable_irq_count
+ * refcount (fts_disableInterrupt()/fts_enableInterrupt()): our single
+ * enable can only remove our own +1 of the IRQ depth, never a hold
+ * the driver took for power cycle / fw update / suspend.
+ */
+static void fts_empty_irq_backoff(struct fts_ts_info *info)
+{
+	unsigned int delay;
+
+	/* Saturate instead of wrapping: a u8 wrap would open a
+	 * 4-IRQ full-rate hiccup once per 256 consecutive empties. */
+	if (info->empty_irq_streak < 255)
+		info->empty_irq_streak++;
+	if (info->empty_irq_streak < FTS_EMPTY_IRQ_STREAK_START)
+		return;
+
+	delay = info->empty_irq_delay_ms ?: FTS_EMPTY_IRQ_DELAY_MIN_MS;
+	info->empty_irq_delay_ms = min(delay << 1,
+				       (unsigned int)FTS_EMPTY_IRQ_DELAY_MAX_MS);
+
+	mutex_lock(&info->empty_irq_lock);
+	if (atomic_cmpxchg(&info->empty_irq_armed, 0, 1) == 0) {
+		disable_irq_nosync(info->client->irq);
+		queue_delayed_work(system_wq, &info->empty_irq_work,
+				   msecs_to_jiffies(delay));
+	}
+	mutex_unlock(&info->empty_irq_lock);
+}
+
+/**
+ * Reset the empty-FIFO backoff after a productive interrupt. The IRQ
+ * is always enabled at this point (the armed flag can only be 0 while
+ * the handler runs), so resetting the tunables is sufficient; no
+ * work cancellation is needed.
+ */
+static void fts_empty_irq_reset(struct fts_ts_info *info)
+{
+	info->empty_irq_streak = 0;
+	info->empty_irq_delay_ms = FTS_EMPTY_IRQ_DELAY_MIN_MS;
+}
+
+/**
+ * Bottom Half Interrupt Handler function
+ * This handler is called each time there is at least one new event in the FIFO and the interrupt pin of the IC goes low.
+ * It will read all the events from the FIFO and dispatch them to the proper event handler according the event ID
+ */
+static irqreturn_t fts_event_handler(int irq, void *ts_info)
+{
+	struct fts_ts_info *info = ts_info;
+	int error = 0, count = 0;
+	unsigned char regAdd = FIFO_CMD_READALL;
+	unsigned char data[FIFO_EVENT_SIZE * FIFO_DEPTH] = {0};
+	unsigned char eventId;
+	const unsigned char EVENTS_REMAINING_POS = 7;
+	const unsigned char EVENTS_REMAINING_MASK = 0x1F;
+	unsigned char events_remaining = 0;
+	bool empty_fifo;
+	unsigned char *evt_data;
+	static char pre_id[3];
+	event_dispatch_handler_t event_handler;
+
+	if (info->tp_pm_suspend) {
+		logError(1, "%s device in suspend, schedue to work", tag);
+		pm_wakeup_event(info->dev, 0);
+		if (!work_pending(&info->sleep_work)) {
+			pm_stay_awake(info->dev);
+			queue_work(info->irq_wq, &info->sleep_work);
+		}
+		return IRQ_HANDLED;
+	}
+
+#ifdef CONFIG_SECURE_TOUCH
+	if (!fts_secure_filter_interrupt(info)) {
+		return IRQ_HANDLED;
+	}
+#endif
+#ifdef CONFIG_FTS_BOOST
+	lpm_disable_for_dev(true, EVENT_INPUT);
+#endif
+	pm_stay_awake(info->dev);
+#ifdef TOUCH_THP_SUPPORT
+	if (info->enable_touch_raw) {
+		count = fts_read_thp_frame(info);
+		copy_touch_rawdata((u8 *)(&info->thp_frame), count);
+		clear_interrupt();
+		update_touch_rawdata();
+		count  = 0;
+		if (info->thp_frame.thp_frame_buf[0x16] == 0)
+			goto end;
+	} else
+#endif
+	if (info->clicktouch_count) {
+		count = get_ms_strength_data(info);
+		copy_touch_rawdata((u8 *)info->strength_buf, count);
+		count  = 0;
+	}
+	info->irq_status = true;
+	error = fts_writeReadU8UX(regAdd, 0, 0, data, FIFO_EVENT_SIZE,
+				  DUMMY_FIFO);
+	events_remaining = data[EVENTS_REMAINING_POS] & EVENTS_REMAINING_MASK;
+	events_remaining = (events_remaining > FIFO_DEPTH - 1) ?
+				FIFO_DEPTH - 1 : events_remaining;
+
+	/*
+	 * Decide whether this IRQ carried no touch data at all. The
+	 * 0x87 FIFO read above has already been issued, which both
+	 * ACKs the controller and releases the INT line - so backing
+	 * off from here on is safe. A truly empty read is: no SPI
+	 * error, zero remaining events and EVT_ID_NOEVENT (0x00) in
+	 * the first event slot.
+	 */
+	empty_fifo = error == OK && events_remaining == 0 &&
+		     data[0] == EVT_ID_NOEVENT;
+
+#ifdef CONFIG_FTS_BOOST
+	/* Empty FIFO IRQs must not keep the CPU frequency floor alive. */
+	if (!empty_fifo)
+		touch_irq_boost();
+#endif
+
+	/*Drain the rest of the FIFO, up to 31 events*/
+	if (error == OK && events_remaining > 0) {
+		error = fts_writeReadU8UX(regAdd, 0, 0, &data[FIFO_EVENT_SIZE],
+					  FIFO_EVENT_SIZE * events_remaining,
+					  DUMMY_FIFO);
+	}
+	if (error != OK) {
+		logError(1,
+		    "Error (%d) while reading from FIFO in fts_event_handler",
+		    error);
+	} else {
+		for (count = 0; count < events_remaining + 1; count++) {
+			evt_data = &data[count * FIFO_EVENT_SIZE];
+			if (pre_id[0] == EVT_ID_USER_REPORT	&&
+				pre_id[1] == 0x02 &&
+				pre_id[2] == 0x18) {
+				pre_id[0] = 0;
+				pre_id[1] = 0;
+				pre_id[2] = 0;
+				continue;
+			}
+			if (evt_data[0] == EVT_ID_NOEVENT)
+				break;
+			eventId = evt_data[0] >> 4;
+			/*Ensure event ID is within bounds*/
+			if (eventId < NUM_EVT_ID) {
+				event_handler = info->event_dispatch_table[eventId];
+				event_handler(info, (evt_data));
+				pre_id[0] = evt_data[0];
+				pre_id[1] = evt_data[1];
+				pre_id[2] = evt_data[2];
+			}
+		}
+	}
+	if (empty_fifo) {
+		/* Empty FIFO: skip the pointless input_sync() and back
+		 * off the IRQ instead. The 0x87 FIFO read at the top of
+		 * this handler has already ACKed the controller, which
+		 * is required before every backoff round. */
+		fts_empty_irq_backoff(info);
+	} else {
+		input_sync(info->input_dev);
+		fts_empty_irq_reset(info);
+	}
+#ifdef TOUCH_THP_SUPPORT
+end:
+#endif
+	info->irq_status = false;
+	if (info->clicktouch_num) {
+		if (info->touch_id && info->clicktouch_count) {
+			info->clicktouch_count--;
+			update_clicktouch_raw ();
+		} else if (!info->touch_id)
+			info->clicktouch_count = info->clicktouch_num;
+	}
+#ifdef CONFIG_FTS_BOOST
+	if (!info->touch_id)
+		lpm_disable_for_dev(false, EVENT_INPUT);
+#endif
+#ifdef FTS_XIAOMI_TOUCHFEATURE
+	wake_up(&info->wait_queue);
+#endif
+	pm_relax(info->dev);
+	return IRQ_HANDLED;
+}
+
