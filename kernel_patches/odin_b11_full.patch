+ * Restore, but never drop rt-boosted threads (surfaceflinger) below RT.
+ * This keeps idle SF binder threads at RT so their wakeups (including
+ * oneway transactions, which skip priority inheritance upstream) are
+ * placed immediately at RT priority. Without this, the idle restore to
+ * proc->default_priority (CFS) undoes any RT boost and re-exposes the
+ * slow-wakeup window on every transaction completion.
+ */
+static void binder_restore_priority_boosted(struct binder_thread *thread,
+					    const struct binder_priority *desired)
+{
+	if (likely(!binder_rt_boost || !thread->proc->rt_boost)) {
+		binder_restore_priority(thread, desired);
+		return;
+	}
