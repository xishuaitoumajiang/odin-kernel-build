diff --git a/drivers/cpufreq/cpufreq_input_boost.c b/drivers/cpufreq/cpufreq_input_boost.c
new file mode 100755
index 000000000..0ed64a79e
--- /dev/null
+++ b/drivers/cpufreq/cpufreq_input_boost.c
@@ -0,0 +1,273 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * cpufreq_input_boost - Touch-driven CPU frequency floor for UI bursts.
+ *
+ * Clean-room replacement for the unpublished XIAOMI_CPUFREQ_EFF behaviour:
+ * on each touch IRQ, raise the FREQ_QOS_MIN floor of the big and prime
+ * clusters to tuned "burst" frequencies, then decay back after a short
+ * quiet period. No touch -> no floor: frequencies are never locked
+ * permanently.
+ *
+ * Burst floors default to the values validated on-device by A/B testing
+ * (policy4 min=1555200, policy7 min=1670400, "好多了").
+ */
+#define pr_fmt(fmt) "input_boost: " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_qos.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+static bool ib_en = true;
+module_param_named(enable, ib_en, bool, 0644);
+MODULE_PARM_DESC(enable, "enable touch input boost");
+
+static unsigned int ib_dur_ms = 200;
+module_param_named(duration_ms, ib_dur_ms, uint, 0644);
+MODULE_PARM_DESC(duration_ms, "decay timeout after the last touch IRQ (ms)");
+
+static unsigned int ib_min_big = 1555200;
+module_param_named(min_big, ib_min_big, uint, 0644);
+MODULE_PARM_DESC(min_big, "FREQ_QOS_MIN floor for the cluster of cpu4-6 (Hz)");
+
+static unsigned int ib_min_prime = 1670400;
+module_param_named(min_prime, ib_min_prime, uint, 0644);
+MODULE_PARM_DESC(min_prime, "FREQ_QOS_MIN floor for the cluster of cpu7 (Hz)");
+
+struct ib_req {
+	struct freq_qos_request qos;
+	bool active;
+};
+static struct ib_req *ib_reqs;
+static DEFINE_MUTEX(ib_lock);
+static bool ib_active;
+static void ib_decay(struct work_struct *ws);
+static DECLARE_DELAYED_WORK(ib_decay_dwork, ib_decay);
+static void ib_input_boost_workfn(struct work_struct *ws);
+static DECLARE_WORK(ib_input_boost_work, ib_input_boost_workfn);
+
+static unsigned int ib_target_for_cpu(unsigned int cpu)
+{
+	if (cpu >= 7)
+		return ib_min_prime;
+	if (cpu >= 4)
+		return ib_min_big;
+	return 0; /* little cluster is left to the governor */
+}
+
+/*
+ * Called from the FTS threaded IRQ handler on every touch IRQ
+ * (see CONFIG_FTS_BOOST hook in fts_spi/fts.c). Runs in process
+ * context, so the mutex and freq_qos calls are safe here.
+ */
+void touch_irq_boost(void)
+{
+	unsigned int cpu;
+
+	if (!ib_en)
+		return;
+
+	mutex_lock(&ib_lock);
+	if (!ib_active) {
+		for_each_possible_cpu(cpu) {
+			struct cpufreq_policy *p;
+			struct ib_req *r = &ib_reqs[cpu];
+			unsigned int target = ib_target_for_cpu(cpu);
+			int ret;
+
+			if (r->active)
+				continue;
+			p = cpufreq_cpu_get_raw(cpu);
+			if (!p || p->cpu != cpu)
+				continue;
+			if (target > p->cpuinfo.max_freq)
+				target = p->cpuinfo.max_freq;
+			/* NOTE: freq_qos_add_request returns 1 on value
+			 * change, 0 on no-change; only < 0 is an error. */
+			ret = freq_qos_add_request(&p->constraints, &r->qos,
+						   FREQ_QOS_MIN, target);
+			if (ret < 0) {
+				pr_warn("cpu%u: qos add failed (%d)\n", cpu, ret);
+				continue;
+			}
+			r->active = true;
+			pr_debug("cpu%u: min->%u\n", cpu, target);
+		}
+		ib_active = true;
+	}
+	/* Re-arm the decay timer on every touch so a continuous swipe
+	 * keeps the floor up without add/remove churn. */
+	mod_delayed_work(system_wq, &ib_decay_dwork,
+			 msecs_to_jiffies(ib_dur_ms));
+	mutex_unlock(&ib_lock);
+}
+EXPORT_SYMBOL_GPL(touch_irq_boost);
+
+/* Input handlers run under the input core's event lock and must not take
+ * ib_lock or update freq_qos directly.  Coalesce high-rate coordinate
+ * reports onto system_wq instead; touch_irq_boost() re-arms its decay timer.
+ */
+static void ib_input_boost_workfn(struct work_struct *ws)
+{
+	touch_irq_boost();
+}
+
+static void ib_input_event(struct input_handle *handle, unsigned int type,
+			   unsigned int code, int value)
+{
+	bool touch = false;
+
+	if (type == EV_KEY && value &&
+	    (code == BTN_TOUCH || code == BTN_TOOL_FINGER))
+		touch = true;
+	else if (type == EV_ABS &&
+		 (code == ABS_MT_POSITION_X || code == ABS_MT_POSITION_Y ||
+		  code == ABS_X || code == ABS_Y))
