+static int __sys_clock_gettime_shim(int clk, struct timespec *ts)
+{
+	struct old_timespec32 { int32_t tv_sec; int32_t	tv_nsec; };
+	struct old_timespec32 ts32;
+#define SYS_clock_gettime32 263
