+{
+	u8 cmd[4] = {FTS_CMD_CUSTOM, 0x01, 0x01, 0x00};
+	int ret = 0;
+	struct fts_ts_info *info = dev_get_drvdata(dev);
+
+	logError(1, " %s %s,buf:%s,count:%zu\n", tag, __func__, buf, count);
+	sscanf(buf, "%u", &info->grip_pixel);
