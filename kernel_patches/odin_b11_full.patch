+						     (short)msRawFrame.node_data[j],
+						     (j + 1) / sense_node);
+				else
+					pos +=
+					    snprintf(info->data_dump_buf + last_pos,
+						     buf_size, "%4d\n",
+						     (short)msRawFrame.node_data[j]);
