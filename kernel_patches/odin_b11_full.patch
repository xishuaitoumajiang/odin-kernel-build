+			logError(1, "%s already pending,skip", tag);
+		}
+	} else {
+#endif
+		ret = fts_palm_sensor_cmd(value);
+		if (!ret)
+			fts_info->palm_sensor_changed = true;
+		if (value == 0)
+			update_palm_sensor_value(0);
+#ifdef CONFIG_SECURE_TOUCH
+	}
+	mutex_unlock(&scr_info->palm_lock);
+#endif
